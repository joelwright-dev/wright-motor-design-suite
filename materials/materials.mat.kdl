// Material database.
//
// Every number here is PROVISIONAL unless its `source` says otherwise. They are typical
// published values for the class of material, good enough to size a part and to get a mass
// within a few percent, and not good enough to sign anything off. The `source` line on each
// material is the place to record where a real number came from when one arrives.
//
// The composite entries matter most and are trusted least. Doc 06 section 4.4 is explicit that
// no crash result on a CFRP part counts as evidence until the material is calibrated against
// coupon and crush-tube tests. Nothing here is calibrated.

// ------------------------------------------------------------------------------ composites

material "cfrp/pultruded-ud-t700-epoxy" version="0.1.0" {
    description "Pultruded unidirectional T700 carbon fibre in epoxy, the MCDSv1 rail material"
    family "cfrp"
    form "pultrusion"
    density "1550 kg/m^3"
    orthotropic e1="130 GPa" e2="8 GPa" g12="4.5 GPa" nu12=0.3
    strength xt="2000 MPa" xc="1100 MPa" yt="50 MPa" yc="180 MPa" s="70 MPa"
    environment max_service_temp="120 C" uv="coat-required" galvanic="isolate-from-aluminium"
    cost "38 AUD/kg"
    source "PROVISIONAL: typical published values for a 60 percent fibre volume UD pultrusion"
    note "Not calibrated. No crash result using this material is evidence of anything yet."
    solver "openradioss" law="LAW25" formulation="CRASURV" \
        note="Progressive damage. Parameters must come from crush-tube tests before use."
    crush sea="65 kJ/kg" efficiency=0.70 trigger_ratio=2.2 validated=#false
    note "The crush figures are the reason this material was chosen and the reason it cannot be           trusted yet. A triggered carbon tube absorbs several times what steel does per           kilogram, and an untriggered one splits down its length and absorbs almost nothing.           Which of those happens is decided by the trigger geometry and the layup, not by the           material, so nothing here counts as evidence until coupon and crush-tube tests exist."
}

material "cfrp/woven-2x2-t300-epoxy" version="0.1.0" {
    description "2x2 twill woven carbon in epoxy, for panels and covers"
    family "cfrp"
    form "prepreg"
    density "1520 kg/m^3"
    orthotropic e1="62 GPa" e2="62 GPa" g12="5 GPa" nu12=0.05
    strength xt="800 MPa" xc="600 MPa" yt="800 MPa" yc="600 MPa" s="90 MPa"
    environment max_service_temp="120 C" uv="coat-required"
    cost "60 AUD/kg"
    source "PROVISIONAL: typical published values"
    solver "openradioss" law="LAW25" formulation="CRASURV"
    crush sea="48 kJ/kg" efficiency=0.68 trigger_ratio=2.0 validated=#false
}

material "gfrp/e-glass-polyester" version="0.1.0" {
    description "E-glass in polyester, for non-structural panels"
    family "gfrp"
    form "laminate"
    density "1900 kg/m^3"
    orthotropic e1="25 GPa" e2="25 GPa" g12="4 GPa" nu12=0.15
    strength xt="300 MPa" xc="250 MPa" yt="300 MPa" yc="250 MPa" s="45 MPa"
    cost "12 AUD/kg"
    source "PROVISIONAL: typical published values"
    crush sea="35 kJ/kg" efficiency=0.65 trigger_ratio=1.9 validated=#false
}

// ---------------------------------------------------------------------------------- metals

material "steel/e355-tube" version="0.1.0" {
    description "E355 cold drawn seamless tube, for suspension arms"
    family "metal"
    form "tube"
    density "7850 kg/m^3"
    isotropic e="210 GPa" nu=0.3
    strength yield="355 MPa" ultimate="490 MPa"
    environment corrosion="paint-or-plate"
    cost "3.60 AUD/kg"
    source "PROVISIONAL: EN 10305-1 grade E355 nominal properties"
    crush sea="22 kJ/kg" efficiency=0.72 trigger_ratio=1.5 validated=#false
}

