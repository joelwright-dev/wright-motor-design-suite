    description "Stand-in for a bought-in aluminium housing whose real construction is unknown"
    family "metal"
    form "assembly"
    density "2700 kg/m^3"
    cost "12 AUD/kg"
    note "An averaged stand-in. Parts using it should declare their mass rather than rely on this."
}

// ------------------------------------------------------------------ polymers and elastomers

material "polymer/pack-composite-average" version="0.1.0" {
    description "Stand-in for a battery pack case: a mixture of steel, aluminium and plastic"
    family "polymer"
    form "assembly"
    density "1200 kg/m^3"
    cost "14 AUD/kg"
    note "An averaged stand-in. The pack declares its own mass from energy and specific energy, \
          so this density affects nothing but a volume figure."
}

material "rubber/tyre-compound" version="0.1.0" {
    description "Tyre carcass and tread, averaged"
    family "elastomer"
    form "moulding"
    density "1100 kg/m^3"
    cost "6 AUD/kg"
    note "A tyre is mostly air, so tyres declare their mass rather than deriving it."
}

material "polymer/abs" version="0.1.0" {
    description "ABS, for interior trim and non-structural covers"
    family "polymer"
    form "moulding"
    density "1050 kg/m^3"
    isotropic e="2.2 GPa" nu=0.35
    strength yield="42 MPa"
    cost "5.50 AUD/kg"
    source "PROVISIONAL: typical published values"
}

