// Road tyre, described the way tyres are actually specified: section width, aspect ratio and
// rim diameter.
//
// The overall diameter, and therefore the rolling radius and the ride height of the whole
// vehicle, falls out of those three numbers. Local frame: the origin is the bead seat centre,
// y outboard.

primitive "wheels/tyre" version="0.1.0" {
    description "Road tyre"
    category "wheels" sub="tyre"

    params {
        section  unit="mm" default=185 min=125 max=355 doc="section width"
        aspect   default=60 min=25 max=85 doc="sidewall height as a percentage of section width"
        rim      unit="inch" default=15 min=12 max=24
        load_index default=84 doc="tyre load index"

        sidewall unit="mm" expr="section * aspect / 100" doc="derived"
        overall  unit="mm" expr="rim * 25.4 mm / 1 inch + 2 * sidewall" doc="derived: overall diameter"
        radius   unit="mm" expr="overall / 2" doc="derived: unloaded radius"

        // Grip scales with how much rubber is on the road. Both of these are referenced to a
        // 185 section, which is the size these coefficients were written for.
        cornering_c1 expr="26.0 * section / 185 mm" doc="derived: cornering stiffness coefficient"
        peak_friction_y expr="1.05 * (section / 185 mm)^0.12" doc="derived: peak lateral friction"
    }

    material "rubber/tyre-compound"

    geometry level="manufacture" {
        cylinder "carcass" d=overall h=section at="(0 mm, 0 mm, 0 mm)" axis="y"
    }

    // A tyre is mostly air. Declared, because the envelope cylinder would say otherwise.
    massprops declared mass="7.5 kg" cg="(0 mm, 0 mm, 0 mm)"

    ports {
        port "bead" type="tyre.bead" at="(0 mm, 0 mm, 0 mm)" axis="y" clock="z" {
            params diameter=rim width=section
        }
    }

    // The tyre model the dynamics simulator uses: a Magic Formula with load sensitive grip.
    //
    // Every coefficient below is PROVISIONAL. They are representative of a modern road tyre in
    // this size on dry asphalt, taken from published ranges rather than measured on ours, and
    // they are the single largest source of error in any handling result. Measuring a real one
    // on a flat-track rig is what replaces them.
    behaviour "tyre" {
        model "magic-formula"
        unloaded_radius radius
        rolling_radius_factor 0.97

        // Nominal vertical load the coefficients are quoted at.
        nominal_load "3500 N"
        // Peak friction at the nominal load, and how much of it is lost as load doubles.
        peak_friction_x 1.15
        load_sensitivity 0.10

        // Cornering stiffness: c1 * Fz0 * sin(2 * atan(Fz / (c2 * Fz0))) newtons per radian.
        // Scaled by section width, because that is most of why a wider tyre corners better.
        cornering_c1 cornering_c1
        // Peak friction also rises a little with width, though far less than people assume.
        peak_friction_y peak_friction_y
        cornering_c2 2.2
        // Longitudinal slip stiffness, as a multiple of the vertical load.
        slip_stiffness 18.0

        // Magic Formula shape and curvature. Together these decide where the curve peaks: a
        // road tyre makes its most grip at about eight degrees of slip, and a curvature near
        // one would push that out past forty, which no road tyre does.
        shape_y 1.50
        shape_x 1.65
        curvature_y 0.0
        curvature_x 0.0

        // How far the tyre has to roll before it develops most of a new slip angle. This is what
        // makes a step steer take time rather than happening instantly.
        relaxation_length "0.45 m"
        rolling_resistance 0.011
    }

    manufacturing {
        method "purchased" scale="1..*" {
            export "spec-sheet"
            cost fixed="0 AUD" per_unit="120 AUD"
        }
    }

    compliance "wheels.tyre"
}
