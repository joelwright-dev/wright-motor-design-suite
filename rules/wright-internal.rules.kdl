// Wright Motor Company internal design rules.
//
// These are our own targets and constraints, not anybody's regulation. Every rule cites the
// document it comes from, and every limit that is still a guess says so. Unlike the regulatory
// packs, these can be verified by reading our own specification, which is why they carry a
// `verified` line and the regulatory template does not.
//
// A rule here failing does not mean the vehicle is illegal. It means it is not the vehicle we
// said we were going to build.

rulepack "wright-internal" version="0.1.0" {
    description "Wright Motor Company design rules for MCDS vehicles"
    source "docs/01-requirements.md and docs/04-mcds-v1-spec.md"
    jurisdiction "internal"

    // ------------------------------------------------------------------ the model is sound

    rule "model.all-parts-placed" {
        title "Every part has a known position"
        source "docs/02-architecture.md section 3.2: placement is derived, never authored"
        verified "J. Wright" date="2026-09-12"
        evidence "calculation"
        check "all(parts, p -> p.placed)"
        on_fail "A part is not connected to the rest of the vehicle, so nothing downstream (mass, \
                 packaging, assembly order) can be trusted. Mate it, or place it explicitly and say why."
        severity "fail"
    }

    rule "model.all-mates-compatible" {
        title "Every joint is between compatible ports"
        source "docs/03-primitive-library.md section 4: port compatibility"
        verified "J. Wright" date="2026-09-12"
        evidence "calculation"
        check "all(mates, m -> m.compatible)"
        on_fail "Two parts are joined through ports that do not fit each other."
        severity "fail"
    }

    // --------------------------------------------------------------------------- MCDS-02

    rule "chassis.mass-fraction" {
        title "Chassis mass as a share of kerb mass"
        source "docs/01-requirements.md MCDS-02: mass budget should go to powertrain and body"
        verified "J. Wright" date="2026-09-12"
        applies_when "chassis.mass > 0 kg"
        evidence "calculation"
        // PROVISIONAL limit. 15 percent of kerb mass is a working target, not a derived figure.
        check "chassis.mass <= 0.15 * vehicle.mass.kerb"
        on_fail "The chassis is taking more of the mass budget than intended. Either the rails are \
                 heavier than planned or the rest of the vehicle is lighter than the target assumed."
        note "PROVISIONAL limit pending the structural work."
        severity "warning"
    }

    rule "chassis.mass-absolute" {
        title "Bare chassis mass against the platform target"
        source "docs/04-mcds-v1-spec.md section 6"
        verified "J. Wright" date="2026-09-12"
        applies_when "chassis.mass > 0 kg"
        evidence "calculation"
        // 120 kg for a full-length standard-width chassis; the 2/3-length narrow target is 70 kg.
        // Until the facts layer exposes the configuration, the looser of the two applies.
        check "chassis.mass <= 120 kg"
        on_fail "The chassis exceeds the platform mass target in doc 04 section 6."
        note "PROVISIONAL. Does not yet include bonded inserts, joint fittings, brackets or the floor."
        severity "warning"
    }

    // --------------------------------------------------------------------------- MCDS-06

    rule "assembly.kit-stage-joining" {
        title "Kit-stage joints use only methods an untrained assembler can make"
        source "docs/01-requirements.md MCDS-06 and docs/03-primitive-library.md section 4.4"
        verified "J. Wright" date="2026-09-12"
        evidence "calculation"
        check "all(filter(mates, m -> m.stage == \"kit\"), m -> m.fastener in [\"bolt\", \"screw\", \"nut\", \"rivnut\", \"clamp\", \"connector\", \"clip\"])"
        on_fail "A joint the customer has to make needs bonding, welding or pressing. Those belong \
                 to the factory stage. Anyone who can assemble flatpack furniture must be able to \
                 assemble this vehicle."
        severity "fail"
    }

    rule "assembly.kit-stage-torque" {
        title "Every structural kit-stage joint has a torque figure"
        source "docs/07-manufacturing-export.md section 5.2: fastener callouts"
        verified "J. Wright" date="2026-09-12"
        evidence "calculation"
        check "all(filter(mates, m -> m.stage == \"kit\" and m.dof == \"fixed\"), m -> m.has_torque)"
        on_fail "A structural joint has no torque specified, so the assembly instructions cannot \
                 tell the customer how tight to do it up."
        severity "fail"
    }

    // ------------------------------------------------------------------ mass and stability

    rule "mass.lateral-balance" {
        title "Centre of gravity is near the centreline"
        source "Design practice: a laterally offset cg makes a car handle differently left and right"
        verified "J. Wright" date="2026-09-12"
        applies_when "vehicle.mass.kerb > 0 kg"
        evidence "calculation"
        check "abs(vehicle.cg.y) <= 30 mm"
        on_fail "The centre of gravity is offset to one side. Check for parts placed on one side only."
        severity "warning"
    }

    rule "mass.cg-height" {
        title "Centre of gravity height"
        source "docs/06-simulation.md section 2: static stability factor"
        verified "J. Wright" date="2026-09-12"
        applies_when "vehicle.mass.kerb > 0 kg"
        evidence "calculation"
        // PROVISIONAL. A passenger car is typically 500 to 600 mm; an SUV is higher. This limit
        // is a flag to think about rollover, not a regulation.
        check "vehicle.cg.z <= 700 mm"
        on_fail "The centre of gravity is high enough to be worth checking against rollover stability."
        note "PROVISIONAL. Replace with a static stability factor check once track width is modelled."
        severity "advisory"
    }


    // ------------------------------------------------------------------ Tier 0 vehicle shape

    rule "stability.static-stability-factor" {
        title "Static stability factor"
        source "docs/06-simulation.md section 2. Half the track over the centre of gravity height."
        verified "J. Wright" date="2026-09-13"
        applies_when "vehicle.category in [\"MA\", \"MB\", \"MC\"]"
        evidence "calculation"
        // A passenger car is usually 1.3 to 1.5; an SUV around 1.1 to 1.2. Below about 1.2 a
        // vehicle is in the range where rollover starts to matter. PROVISIONAL threshold.
        check "tier0.static_stability_factor >= 1.25"
        on_fail "The centre of gravity is high relative to the track. Lower it, widen the track,                  or accept that this is a vehicle with SUV-like rollover behaviour and say so."
        note "PROVISIONAL threshold. The static stability factor ignores suspension and tyres; it               is a flag to investigate, not a verdict. Replace with a sine-with-dwell simulation               once Tier 1 exists."
        severity "warning"
    }

    rule "stability.weight-distribution" {
        title "Static weight distribution"
        source "Design practice"
        verified "J. Wright" date="2026-09-13"
        applies_when "vehicle.category in [\"MA\", \"MB\", \"MC\"]"
        evidence "calculation"
        check "tier0.front_fraction >= 0.35 and tier0.front_fraction <= 0.65"
        on_fail "The static weight distribution is outside the range a road car normally sits in.                  Very rear-biased cars need care with lift-off behaviour; very front-biased ones                  understeer and wear front tyres."
        severity "advisory"
    }

    rule "dimensions.ground-clearance" {
        title "Ground clearance"
        source "Design practice, and the chassis rails are the lowest structure on an MCDS vehicle"
        verified "J. Wright" date="2026-09-13"
        applies_when "vehicle.category in [\"MA\", \"MB\", \"NA\"]"
        evidence "calculation"
        // Measured to the lowest structure that is not a wheel. PROVISIONAL threshold.
        check "tier0.ground_clearance >= 120 mm"
        on_fail "The lowest structure is close enough to the ground that speed humps, driveways                  and kerbs will reach it."
        note "PROVISIONAL. An off-road vehicle wants far more; a low sports car deliberately less."
        severity "warning"
    }

    rule "dimensions.wheelbase-is-known" {
        title "The vehicle has two axles at a known spacing"
        source "Tier 0 cannot produce axle loads without them"
        verified "J. Wright" date="2026-09-13"
        evidence "calculation"
        check "tier0.wheelbase > 1500 mm"
        on_fail "No wheelbase could be worked out, or it is implausibly short. Until the wheels                  are modelled, nothing that depends on axle loads means anything."
        severity "warning"
    }

    // ---------------------------------------------------------------------- data hygiene

    rule "data.materials-known" {
        title "Every part names a material"
        source "docs/03-primitive-library.md section 5"
        verified "J. Wright" date="2026-09-12"
        evidence "calculation"
        check "all(parts, p -> p.material != \"\")"
        on_fail "A part has no material, so it has no mass, no cost and no manufacturing route."
        severity "warning"
    }

    // ------------------------------------------------------ things software cannot decide

    rule "structure.chassis-torsional-stiffness" {
        title "Chassis torsional stiffness"
        source "docs/04-mcds-v1-spec.md section 6: at least 12 kN·m/deg with the floor bonded"
        verified "J. Wright" date="2026-09-12"
        evidence "simulation" sim="structure.torsion"
        check "result.torsional_stiffness >= 12 kNm/deg"
        on_fail "The chassis is less stiff in torsion than the platform target."
        note "Needs the Tier 2 implicit pipeline, which is Phase 5."
        severity "warning"
    }

    rule "structure.crush-calibration" {
        title "Composite crush behaviour is calibrated against physical tests"
        source "docs/06-simulation.md section 4.4: uncalibrated composite results are not evidence"
        verified "J. Wright" date="2026-09-12"
        evidence "physical-test"
        note "Coupon and crush-tube tests on the pultruded rail material. Until these exist, no \
              crash simulation result on a CFRP part counts as evidence of anything."
        severity "fail"
    }

    // ---------------------------------------------------------------- braking and steering
    //
    // These rules read the compliance tags each primitive declares, not part names. A different
    // caliper, or a caliper from a supplier, satisfies them as long as it says what it is.

    rule "braking.dual-circuit" {
        title "The service brake has two independent circuits"
        source "docs/01-requirements.md WMDS-07, and ADR 31 clause 5 for the underlying rule"
        verified "J. Wright" date="2026-09-13"
        evidence "calculation"
        check "count(filter(parts, p -> \"braking.dual-circuit\" in p.tags)) >= 1"
        on_fail "No part in the vehicle provides two independent brake circuits. A single circuit \
                 loses all braking from one failure and is not road legal anywhere."
        severity "fail"
    }

    rule "braking.a-brake-at-every-wheel" {
        title "Every wheel has a brake"
        source "docs/01-requirements.md WMDS-07"
        verified "J. Wright" date="2026-09-13"
        applies_when "count(filter(parts, p -> p.category == \"wheels\")) > 0"
        evidence "calculation"
        check "count(filter(parts, p -> \"braking.disc\" in p.tags)) >= count(filter(parts, p -> p.source == \"wheels/wheel-steel\"))"
        on_fail "There are fewer brake discs than wheels. Check which corner is missing one."
        severity "fail"
    }

    rule "braking.caliper-per-disc" {
        title "Every disc has something to clamp it"
        source "docs/01-requirements.md WMDS-07"
        verified "J. Wright" date="2026-09-13"
        applies_when "count(filter(parts, p -> \"braking.disc\" in p.tags)) > 0"
        evidence "calculation"
        check "count(filter(parts, p -> \"braking.caliper\" in p.tags)) >= count(filter(parts, p -> \"braking.disc\" in p.tags))"
        on_fail "A disc has no caliper on it, so that wheel has no brake."
        severity "fail"
    }

    rule "steering.column-collapses" {
        title "The steering column is a collapsible type"
        source "ADR 10 requires the steering control not to displace rearward in a frontal impact"
        verified "J. Wright" date="2026-09-13"
        applies_when "count(filter(parts, p -> \"steering\" in p.tags)) > 0"
        evidence "calculation"
        check "count(filter(parts, p -> \"impact.steering-column\" in p.tags)) >= 1"
        on_fail "The vehicle has steering but no column that says it collapses. A rigid column \
                 drives the steering wheel into the driver in a frontal impact."
        note "This checks only that a collapsible column is fitted. Whether it displaces less \
              than the limit is a physical test, covered by the impact rule in the ADR pack."
        severity "fail"
    }

    rule "steering.one-tie-rod-per-steered-wheel" {
        title "Both front wheels are steered"
        source "docs/03-primitive-library.md: a steering rack drives one tie rod per side"
        verified "J. Wright" date="2026-09-13"
        applies_when "count(filter(parts, p -> \"steering.rack\" in p.tags)) > 0"
        evidence "calculation"
        check "count(filter(parts, p -> \"steering.linkage\" in p.tags)) >= 2"
        on_fail "A steering rack is fitted but fewer than two tie rods reach the wheels."
        severity "fail"
    }


    rule "steering.right-hand-drive" {
        title "An Australian vehicle is right-hand drive"
        source "Motor Vehicle Standards Act and ADR 42: vehicles for the Australian market are                 right-hand drive, and the driving controls are on the right"
        verified "J. Wright" date="2026-09-13"
        applies_when "\"AU\" in vehicle.markets and count(filter(parts, p -> \"steering.wheel\" in p.tags)) > 0"
        evidence "calculation"
        // Vehicle y is positive to the left, so the driver's side is negative.
        check "all(filter(parts, p -> \"steering.wheel\" in p.tags), p -> p.y < 0 mm)"
        on_fail "The steering wheel is on the left. This vehicle is built for a market that                  drives on the left, which means the driver sits on the right."
        note "Found by the symmetry report: the steering column, the wheel and the master               cylinder were all on the wrong side, and so was the driver's mass."
        severity "fail"
    }

    rule "layout.symmetric-about-the-centreline" {
        title "Everything off the centreline is either paired or deliberately single"
        source "Design practice: an unpaired part is usually one somebody forgot to fit twice"
        verified "J. Wright" date="2026-09-13"
        evidence "calculation"
        // Suspension and wheels always come in pairs. Braking is left out because a master
        // cylinder is legitimately a single part on the driver's side, and steering is left out
        // because all of it is.
        // The same count on each side of the centreline, rather than a total, so that a part
        // fitted twice on one side is caught as well as one fitted only once.
        check "count(filter(parts, p -> (p.category == \"suspension\" or p.category == \"wheels\") and p.y > 20 mm)) == count(filter(parts, p -> (p.category == \"suspension\" or p.category == \"wheels\") and p.y < -20 mm))"
        on_fail "There are more suspension or wheel parts on one side than the other, so one of                  them has no opposite number."
        severity "fail"
    }

}
