// Reference vehicle: a small electric hatchback on a 2/3-length narrow MCDSv1 chassis.
//
// This is the vehicle the suite is developed against. It is deliberately the smallest
// configuration MCDS supports, because the hardest packaging question for a modular platform is
// whether the small end of the range is still a sensible car.
//
// It is incomplete. Suspension, steering, brakes, wheels, body and interior are not in the
// library yet, so the mass below is the chassis, the battery and the drive unit plus declared
// point masses for everything else. Every number here is provisional and says so.
//
// Try it:
//   wmds veh show vehicles/reference-city-ev/reference-city-ev.veh.kdl --build
//   wmds veh show vehicles/reference-city-ev/reference-city-ev.veh.kdl --build --step car.step

vehicle "reference/city-ev" version="0.1.0" {
    description "Reference small EV on a 2/3-length narrow MCDSv1 chassis"

    // ADR category MA: a passenger car with up to nine seats.
    category "MA"
    markets "AU"
    rule_packs "wright-internal"

    chassis system="mcds-v1" id="chassis" {
        configuration "2/3-length"
        width "narrow"
        rail_section "120x60"
        section "front" length="1100 mm"
        section "central" length="1900 mm"
    }

    instances {
        // The pack spans most of the central section, under the floor between the rails.
        instance "battery" primitive="energy/battery/pack-modular" {
            set energy="40 kWh" length="1400 mm" width="900 mm" height="150 mm" \
                mount_span_x="1200 mm" mount_span_y="960 mm"
        }

        // Rear-mounted drive unit, ahead of the rear axle line.
        instance "drive" primitive="drivetrain/motor/drive-unit" {
            set peak_power="110 kW" mount_span_x="300 mm" mount_span_y="960 mm"
        }

        // Front suspension. Each corner is a sub-assembly that bolts to four grid stations; the
        // right corner is the same definition with every handed part mirrored.
        instance "corner_fl" assembly="corners/front-dw" {
            set side="left"
        }
        instance "corner_fr" assembly="corners/front-dw" {
            set side="right"
        }
    }

    mates {
        // The battery is bolted at four corners. The first mate positions it; the other three
        // are checked for closure, which is how a mislaid mounting foot gets caught.
        mate "battery_fl" a="chassis.station_left_2"   b="battery.mount_fl" {
            fasteners kind="bolt" size="M12" grade="8.8" qty="1" torque="90 Nm" washer="flat"
            stage "kit"
        }
        mate "battery_fr" a="chassis.station_right_2"  b="battery.mount_fr" {
            fasteners kind="bolt" size="M12" grade="8.8" qty="1" torque="90 Nm" washer="flat"
            stage "kit"
        }
        mate "battery_rl" a="chassis.station_left_14"  b="battery.mount_rl" {
            fasteners kind="bolt" size="M12" grade="8.8" qty="1" torque="90 Nm" washer="flat"
            stage "kit"
        }
        mate "battery_rr" a="chassis.station_right_14" b="battery.mount_rr" {
            fasteners kind="bolt" size="M12" grade="8.8" qty="1" torque="90 Nm" washer="flat"
            stage "kit"
        }

        mate "drive_fl" a="chassis.station_left_16"  b="drive.mount_fl" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="1" torque="110 Nm"
            stage "kit"
        }
        mate "drive_fr" a="chassis.station_right_16" b="drive.mount_fr" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="1" torque="110 Nm"
            stage "kit"
        }
        mate "drive_rl" a="chassis.station_left_19"  b="drive.mount_rl" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="1" torque="110 Nm"
            stage "kit"
        }
        mate "drive_rr" a="chassis.station_right_19" b="drive.mount_rr" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="1" torque="110 Nm"
            stage "kit"
        }

        // Front left corner. The first mate positions the corner; the other three check that its
        // remaining brackets land on the stations they are supposed to.
        mate "corner_fl_lf" a="chassis.station_left_-10" b="corner_fl.station_lower_front" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fl_uf" a="chassis.station_left_-9" b="corner_fl.station_upper_front" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fl_ur" a="chassis.station_left_-7" b="corner_fl.station_upper_rear" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fl_lr" a="chassis.station_left_-6" b="corner_fl.station_lower_rear" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }

        // Front right corner, on the mirrored stations.
        mate "corner_fr_lf" a="chassis.station_right_-10" b="corner_fr.station_lower_front" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fr_uf" a="chassis.station_right_-9" b="corner_fr.station_upper_front" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fr_ur" a="chassis.station_right_-7" b="corner_fr.station_upper_rear" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
        mate "corner_fr_lr" a="chassis.station_right_-6" b="corner_fr.station_lower_rear" {
            fasteners kind="bolt" size="M12" grade="10.9" qty="2" torque="90 Nm"
            stage "kit"
        }
    }

    // Everything not yet modelled, carried as point masses so the vehicle mass is not a
    // fiction. These are PROVISIONAL estimates for a car of this size and go away one by one as
    // the real primitives arrive. The front suspension and front wheels have already gone: they
    // are modelled now, in the two corner sub-assemblies above.
    masses {
        mass "body_and_closures"  value="180 kg" at="(400 mm, 0 mm, 700 mm)"  state="kerb"
        mass "suspension_rear"    value="50 kg"  at="(1800 mm, 0 mm, 100 mm)" state="kerb"
        mass "wheels_and_tyres_rear" value="30 kg" at="(1800 mm, 0 mm, 0 mm)"   state="kerb"
        mass "brakes_and_lines"   value="35 kg"  at="(450 mm, 0 mm, 200 mm)"  state="kerb"
        mass "steering"           value="18 kg"  at="(-700 mm, 0 mm, 400 mm)" state="kerb"
        mass "interior_and_seats" value="90 kg"  at="(700 mm, 0 mm, 600 mm)"  state="kerb"
        mass "electrical_lv"      value="25 kg"  at="(0 mm, 0 mm, 400 mm)"    state="kerb"
        mass "driver"             value="80 kg"  at="(600 mm, 350 mm, 750 mm)" state="laden"
        mass "passenger"          value="80 kg"  at="(600 mm, -350 mm, 750 mm)" state="laden"
    }
}
